NODE_ENV=production
PORT=8787
POLL_INTERVAL_MS=60000
MARKET_PROVIDER_TIMEOUT_MS=2500

# Main domestic quote
ICBC_PRODUCT_CODE=080020000521
# active=工银主动价, sell=赎回价, regular=参考价
ICBC_PRICE_FIELD=active
TRADING_QUOTE_STALE_MS=90000
TRADING_CONSENSUS_WARNING_THRESHOLD=0.0025
TRADING_CONSENSUS_CRITICAL_THRESHOLD=0.006

# Core quote and macro providers
FRED_API_KEY=
COT_GOLD_NET_URL=
GLD_HOLDINGS_CSV_URL=
GLD_HOLDINGS_URL=
ZHESHANG_ACCUMULATION_GOLD_URL=https://api.tangdouz.com/a/zsgold.php
ZHESHANG_ACCUMULATION_GOLD_JSON_PATH=
DISABLE_DEFAULT_ZHESHANG_REFERENCE=0
AU9999_REFERENCE_URL=
AU9999_REFERENCE_JSON_PATH=

# Official/professional factor CSV sources
LBMA_GOLD_PM_CSV_URL=
IBA_GOLD_PM_CSV_URL=
LBMA_GOLD_PM_CSV_AUTH_HEADER=
WGC_GOLD_ETF_FLOW_CSV_URL=
WGC_GOLD_ETF_FLOW_API_URL=https://fsapi.gold.org/api/v11/charts/etfv2/revised/flows-chart2?break-cache=11May26
CENTRAL_BANK_GOLD_CSV_URL=
CENTRAL_BANK_GOLD_PAGE_URL=https://www.gold.org/goldhub/research/gold-demand-trends/gold-demand-trends-full-year-2025/central-banks
CME_GOLD_OI_CSV_URL=
CME_GOLD_OI_OFFICIAL_CSV_URL=
CME_GOLD_OI_CSV_AUTH_HEADER=
CME_GOLD_VOLUME_CSV_URL=
CME_GOLD_VOLUME_OFFICIAL_CSV_URL=

# News and expert opinion feeds, comma-separated RSS URLs
GOLD_NEWS_RSS_URLS=
GOLD_BLOGGER_RSS_URLS=

# Optional domestic cross-check feeds for AU9999 / 浙商积存金 / other bank accumulation products.
# JSON path examples: data.price, result.latestPrice
ZHESHANG_ACCUMULATION_GOLD_URL=
ZHESHANG_ACCUMULATION_GOLD_JSON_PATH=
AU9999_REFERENCE_URL=
AU9999_REFERENCE_JSON_PATH=
ACCUMULATION_GOLD_REFERENCE_URLS=

# Storage: file | sqlite | postgres
STORAGE_ADAPTER=sqlite
DATA_DIR=/var/data/gold-monitor
SQLITE_FILE=/var/data/gold-monitor/gold-monitor.sqlite

# Postgres HTTP SQL gateway mode
POSTGRES_HTTP_URL=
POSTGRES_HTTP_TOKEN=
POSTGRES_HTTP_TIMEOUT_MS=5000

# Vercel cron ingest
CRON_SECRET=
INGEST_REFRESH_TTL_MS=60000

# Standalone Postgres gateway service
DATABASE_URL=
POSTGRES_GATEWAY_PORT=8790
POSTGRES_SSL=1
POSTGRES_GATEWAY_MAX_ROWS=1000
POSTGRES_GATEWAY_BODY_LIMIT=5mb
