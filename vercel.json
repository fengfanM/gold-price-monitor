{
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "env": {
    "DATA_DIR": "/tmp/gold-price-monitor",
    "ENABLE_INLINE_MARKET_CONTEXT": "0"
  },
  "functions": {
    "api/cron/ingest.ts": {
      "maxDuration": 60
    },
    "api/cron/providers.ts": {
      "maxDuration": 60
    },
    "api/admin/backfill-history.ts": {
      "maxDuration": 30
    },
    "api/providers/health.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/providers",
      "schedule": "17 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
